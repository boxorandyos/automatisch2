<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Password reset</title>
  </head>
  <body>
    <p>Hi {{ fullName }},</p>

    <p>
      We received a request to reset the password for your account. Use the
      link below to choose a new password. The link expires after a short time.
    </p>

    <p>
      <a href="{{ webAppUrl }}/reset-password?token={{ token }}">
        Set a new password
      </a>
    </p>

    <p>
      If you did not ask for a password reset, you can ignore this message.
      Your current password will stay the same.
    </p>
  </body>
</html>
